<Window x:Class="MyAgent.Desktop.ConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认" Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False" ResizeMode="NoResize"
        KeyDown="Window_KeyDown">
    <!-- 页内确认卡片（mirrors harness ui-primitives Modal / RiskConfirmation）：
         圆角卡片 + 标题 + 次级色描述 + 右对齐"描边取消 / 主色确认"。
         危险操作（删除等）确认按钮走 Danger 红色，单按钮模式用于纯提示。 -->
    <Border CornerRadius="28" Background="{DynamicResource MenuSurface}"
            BorderBrush="{DynamicResource BorderL2}" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.18" Color="#0F1115" />
        </Border.Effect>
        <StackPanel>
            <DockPanel Margin="24,18,24,0">
                <Button DockPanel.Dock="Right" Content="✕" FontSize="14"
                        Style="{StaticResource IconButton}" Click="Cancel_Click" />
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock x:Name="MessageText" Margin="24,10,24,4" FontSize="13" LineHeight="21"
                       TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
            <DockPanel Margin="24,14,24,18" LastChildFill="False">
                <Button x:Name="ConfirmBtn" DockPanel.Dock="Right" Padding="18,8" Margin="8,0,0,0"
                        Click="Confirm_Click" Cursor="Hand" MinWidth="88">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button x:Name="CancelBtn" DockPanel.Dock="Right" Content="取消" Padding="18,8"
                        Click="Cancel_Click" Cursor="Hand" MinWidth="72"
                        Foreground="{DynamicResource TextPrimary}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource BgLayer1}" BorderBrush="{DynamicResource BorderL2}"
                                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
