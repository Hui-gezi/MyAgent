<Window x:Class="MyAgent.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="640" Height="540"
        WindowStartupLocation="CenterOwner" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        ShowInTaskbar="False" ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Background" Value="{DynamicResource BgLayer1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderL2}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
    </Window.Resources>
    <Border CornerRadius="28" Background="{DynamicResource MenuSurface}"
            BorderBrush="{DynamicResource BorderL2}" BorderThickness="1" Margin="16">
        <Border.Effect>
            <DropShadowEffect BlurRadius="48" ShadowDepth="16" Opacity="0.18" Color="#0F1115" />
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="24,18,24,12">
                <Button x:Name="CloseBtn" DockPanel.Dock="Right" Content="✕" FontSize="14"
                        Foreground="{DynamicResource TextSecondary}" Background="Transparent"
                        BorderThickness="0" Cursor="Hand" Click="Cancel_Click" />
                <TextBlock Text="设置" FontSize="16" FontWeight="SemiBold" />
            </DockPanel>
            <DockPanel DockPanel.Dock="Bottom" Margin="24,12,24,18" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="保存" Padding="18,8" Margin="8,0,0,0" Click="Save_Click" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource BrandPrimary}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Foreground>
                        <DynamicResource ResourceKey="BrandPrimaryText" />
                    </Button.Foreground>
                </Button>
                <Button DockPanel.Dock="Right" Content="取消" Padding="18,8" Click="Cancel_Click" Cursor="Hand"
                        Foreground="{DynamicResource TextPrimary}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{DynamicResource BgLayer1}" BorderBrush="{DynamicResource BorderL2}"
                                    BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </DockPanel>
            <DockPanel>
                <Border DockPanel.Dock="Left" Width="160" BorderBrush="{DynamicResource BorderL1}" BorderThickness="0,0,1,0" Padding="8">
                    <StackPanel>
                        <Button x:Name="NavModel" Content="模型服务" Padding="12,8" Click="NavModel_Click" Cursor="Hand"
                                HorizontalContentAlignment="Left" FontSize="13">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="NavAppearance" Content="外观" Padding="12,8" Margin="0,4,0,0" Click="NavAppearance_Click" Cursor="Hand"
                                HorizontalContentAlignment="Left" FontSize="13" Foreground="{DynamicResource TextSecondary}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,16,24,24">
                    <Grid>
                        <StackPanel x:Name="ModelPanel">
                            <TextBlock Text="服务商" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="ProviderBox" FontSize="13" Padding="10,8" SelectionChanged="Provider_Changed">
                                <ComboBoxItem Content="Mock（无 Key 演示）" Tag="mock" />
                                <ComboBoxItem Content="Anthropic 协议" Tag="anthropic" />
                                <ComboBoxItem Content="OpenAI 兼容" Tag="openai-compat" />
                            </ComboBox>
                            <TextBlock Text="API Key" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <PasswordBox x:Name="ApiKeyBox" FontSize="13" Padding="10,8" />
                            <TextBlock Text="留空则读取环境变量 MYAGENT_API_KEY" FontSize="11.5" Foreground="{DynamicResource TextTertiary}" Margin="0,4,0,0" />
                            <TextBlock Text="Base URL" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <TextBox x:Name="BaseUrlBox" FontSize="13" Padding="10,8" />
                            <TextBlock Text="模型" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <DockPanel>
                                <Button x:Name="FetchModelsBtn" DockPanel.Dock="Right" Content="获取列表"
                                        Margin="8,0,0,0" Padding="12,8" FontSize="12.5" Click="FetchModels_Click"
                                        Cursor="Hand" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{DynamicResource BgLayer1}"
                                                    BorderBrush="{DynamicResource BorderL2}" BorderThickness="1"
                                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <ComboBox x:Name="ModelBox" FontSize="13" Padding="10,8" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            </DockPanel>
                            <TextBlock x:Name="ModelListStatus" FontSize="11.5" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Foreground="{DynamicResource TextTertiary}" />
                            <CheckBox x:Name="ThinkingBox" Content="启用思考（thinking）" FontSize="13" Margin="0,16,0,0" />
                            <TextBlock Text="推理强度" FontSize="12.5" FontWeight="SemiBold" Margin="0,16,0,6" />
                            <ComboBox x:Name="EffortBox" FontSize="13" Padding="10,8">
                                <ComboBoxItem Content="low" />
                                <ComboBoxItem Content="medium" />
                                <ComboBoxItem Content="high" />
                            </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="AppearancePanel" Visibility="Collapsed">
                            <TextBlock Text="主题" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <ComboBox x:Name="ThemeBox" FontSize="13" Padding="10,8">
                                <ComboBoxItem Content="跟随系统" Tag="system" />
                                <ComboBoxItem Content="浅色" Tag="light" />
                                <ComboBoxItem Content="深色" Tag="dark" />
                            </ComboBox>
                            <TextBlock Text="界面配色随主题切换即时生效。" FontSize="11.5"
                                       Foreground="{DynamicResource TextTertiary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </DockPanel>
    </Border>
</Window>