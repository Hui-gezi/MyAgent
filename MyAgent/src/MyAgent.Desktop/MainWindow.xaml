<Window x:Class="MyAgent.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MyAgent.Desktop"
        Title="MyAgent"
        Icon="Assets/logo.png"
        Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        Background="{DynamicResource SidebarFill}"
        FontFamily="{StaticResource TextFont}" FontSize="14"
        TextElement.Foreground="{DynamicResource TextPrimary}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- icons -->
        <StreamGeometry x:Key="ChevronGeo">M6,3 L11,8 L6,13</StreamGeometry>
        <StreamGeometry x:Key="PlusGeo">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
        <StreamGeometry x:Key="SendGeo">M8,13 L8,3 M3.5,7.5 L8,3 L12.5,7.5</StreamGeometry>
        <StreamGeometry x:Key="ThinkingGeo">M8,1.5 a4.5,4.5 0 0 1 2.6,8.2 c-0.5,0.4 -0.8,1 -0.8,1.6 v0.2 H6.2 v-0.2 c0,-0.6 -0.3,-1.2 -0.8,-1.6 A4.5,4.5 0 0 1 8,1.5 z M6.5,13.5 L9.5,13.5 M7,15 L9,15</StreamGeometry>
        <StreamGeometry x:Key="ToolGeo">M9.5,4.5 a3,3 0 0 0 -4,4 L2,12 l2,2 3.5,-3.5 a3,3 0 0 0 4,-4 L9,9 7,7 z</StreamGeometry>
        <StreamGeometry x:Key="FileGeo">M4,1.5 h5.5 L13,5 v9.5 H4 z M9.5,1.5 L9.5,5 L13,5</StreamGeometry>
        <StreamGeometry x:Key="FolderGeo">M1.5,3.5 h4 l1.5,2 h7.5 v8 h-13 z</StreamGeometry>
        <StreamGeometry x:Key="GearGeo">M8,1.5 L8,3.5 M8,12.5 L8,14.5 M1.5,8 L3.5,8 M12.5,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M12.6,3.4 L11.2,4.8 M4.8,11.2 L3.4,12.6</StreamGeometry>
        <StreamGeometry x:Key="SidebarGeo">M2,3 h12 v10 h-12 z M6,3 L6,13</StreamGeometry>
        <StreamGeometry x:Key="RightbarGeo">M2,3 h12 v10 h-12 z M10,3 L10,13</StreamGeometry>
        <StreamGeometry x:Key="PencilGeo">M11,2.5 l2.5,2.5 L5,13.5 H2.5 V11 z</StreamGeometry>
        <StreamGeometry x:Key="ArchiveGeo">M2,3 h12 v3 h-12 z M3.5,6 v7 h9 V6 M6.5,8.5 L9.5,8.5</StreamGeometry>
        <StreamGeometry x:Key="FolderPlusGeo">M1.5,3.5 h4 l1.5,2 h7.5 v8 h-13 z M8,7.5 v4 M6,9.5 h4</StreamGeometry>
        <StreamGeometry x:Key="SearchGeo">M7,2.5 a4.5,4.5 0 1 0 0.01,0 M10.5,10.5 L14,14</StreamGeometry>
        <StreamGeometry x:Key="CheckGeo">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
        <StreamGeometry x:Key="TrashGeo">M3,4 h10 M6.5,4 V2.5 h3 V4 M4.5,4 l0.7,9.5 h5.6 L11.5,4 M6.5,6.5 v5 M9.5,6.5 v5</StreamGeometry>

        <!-- pulse animation for ongoing dots -->
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding State}" Value="ongoing">
                    <Setter Property="Fill" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="in_progress">
                    <Setter Property="Fill" Value="{DynamicResource Accent}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="done">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="completed">
                    <Setter Property="Fill" Value="{DynamicResource Success}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="error">
                    <Setter Property="Fill" Value="{DynamicResource Danger}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="ongoing">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="Pulse">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.35" Duration="0:0:0.6" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Pulse" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- todo 行模板：对话区摘要展开后的清单渲染（状态点 + 完成删除线） -->
        <DataTemplate x:Key="TodoRowTemplate">
            <DockPanel Margin="0,3">
                <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"
                         Style="{StaticResource StateDot}" />
                <TextBlock Text="{Binding Content}" FontSize="13" TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
                                    <Setter Property="TextDecorations" Value="Strikethrough" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </DataTemplate>

        <Style x:Key="ShimmerText" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="Shimmer">
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.45" Duration="0:0:0.9" AutoReverse="True" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="Shimmer" />
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- transparent row button base -->
        <Style x:Key="RowButton" TargetType="Button">
            <!-- 显式 Style 会屏蔽 App 级隐式 Button 样式，需自带主题前景色，
                 否则回落到系统主题的黑色，深色模式下文字看不清。 -->
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgLayer2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== chat item templates ===== -->
        <DataTemplate DataType="{x:Type local:UserItem}">
            <DockPanel Margin="0,14">
                <Border HorizontalAlignment="Right" MaxWidth="525"
                        Background="{DynamicResource Bubble}" CornerRadius="16" Padding="14,10">
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                             Background="Transparent" BorderThickness="0" Padding="0" FontSize="14"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                </Border>
            </DockPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CompactionItem}">
            <Border Margin="0,12" Padding="12,8" CornerRadius="12" Background="{DynamicResource BgLayer2}">
                <TextBlock Text="上下文已压缩为检查点摘要" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ErrorItem}">
            <Border Margin="0,12" Padding="12,8" CornerRadius="12" Background="{DynamicResource BgLayer2}"
                    BorderBrush="{DynamicResource Danger}" BorderThickness="1">
                <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsUndoEnabled="False"
                         Background="Transparent" BorderThickness="0" Padding="0" FontSize="12.5"
                         TextWrapping="Wrap" Foreground="{DynamicResource Danger}" />
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:MarkdownItem}">
            <FlowDocumentScrollViewer Document="{Binding Text, Converter={StaticResource Markdown}}"
                                      VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                                      Background="Transparent" BorderThickness="0" Padding="0" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ReasoningItem}">
            <StackPanel Margin="0,8">
                <Button Style="{StaticResource RowButton}" Padding="6,4" Click="ReasoningToggle_Click">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ChevronGeo}" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding IsOpen, Converter={StaticResource BoolAngle}, ConverterParameter=90}" />
                            </Path.RenderTransform>
                        </Path>
                        <Path Data="{StaticResource ThinkingGeo}" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"
                              Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Summary}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                   TextTrimming="CharacterEllipsis" MaxWidth="560"
                                   Style="{StaticResource ShimmerText}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Border Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}"
                        Margin="12,0,0,0" BorderBrush="{DynamicResource BorderL2}" BorderThickness="2,0,0,0"
                        Padding="28,6,10,8">
                    <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                             Background="Transparent" BorderThickness="0" Padding="0" FontSize="13"
                             TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ToolItem}">
            <!-- 显隐由宿主 ItemsControl 直接绑定组对象控制（回收安全），模板不再找祖先。 -->
            <Border Margin="0,6" BorderBrush="{DynamicResource BorderL1}" BorderThickness="1"
                    CornerRadius="12" ClipToBounds="True">
                <StackPanel>
                    <Button Padding="12,8" Click="ToolToggle_Click" Cursor="Hand"
                            Background="{DynamicResource BgLayer2}" HorizontalContentAlignment="Stretch">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ToolRowHover}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <DockPanel>
                            <Ellipse Style="{StaticResource StateDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource ToolGeo}" Stroke="{DynamicResource TextPrimary}"
                                  StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform"
                                  Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                       Margin="0,0,8,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource ChevronGeo}" Stroke="{DynamicResource TextTertiary}"
                                  StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"
                                  DockPanel.Dock="Right" RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="{Binding IsOpen, Converter={StaticResource BoolAngle}, ConverterParameter=90}" />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{Binding Brief}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                    <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource BoolVis}}">
                        <Border BorderBrush="{DynamicResource BorderL1}" BorderThickness="0,1,0,0" Background="{DynamicResource CodeBg}">
                            <StackPanel>
                                <TextBlock Text="参数" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}" Padding="12,6,12,0" />
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <TextBox Text="{Binding ArgsJson, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                                             TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                        <Border Visibility="{Binding HasResult, Converter={StaticResource BoolVis}}"
                                BorderBrush="{DynamicResource BorderL1}" BorderThickness="0,1,0,0" Background="{DynamicResource CodeBg}">
                            <StackPanel>
                                <TextBlock Text="{Binding ResultLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}" Padding="12,6,12,0" />
                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" Padding="12,10">
                                    <TextBox Text="{Binding ResultContent, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False" IsUndoEnabled="False"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             FontFamily="{StaticResource MonoFont}" FontSize="12"
                                             TextWrapping="Wrap">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox">
                                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ResultIsError}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:AssistantItem}">
            <ItemsControl ItemsSource="{Binding Blocks}" Margin="0,10" />
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:ProcessGroupItem}">
            <StackPanel Margin="0,10">
                <Button Style="{StaticResource RowButton}" Padding="10,6" Click="ProcessHeader_Click"
                        Visibility="{Binding ShowHeader, Converter={StaticResource BoolVis}}">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource ChevronGeo}" Stroke="{DynamicResource TextSecondary}"
                              StrokeThickness="1.8" Width="12" Height="12" Stretch="Uniform"
                              RenderTransformOrigin="0.5,0.5" Margin="0,0,8,0" VerticalAlignment="Center">
                            <Path.RenderTransform>
                                <RotateTransform Angle="{Binding ShowBody, Converter={StaticResource BoolAngle}, ConverterParameter=90}" />
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock Text="{Binding HeaderLabel}" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                </Button>
                <!-- 可见性直接绑组对象（模板 DataContext），不用 FindAncestor：
                     虚拟化回收容器脱离可视树时祖先查找会失败并刷绑定告警。 -->
                <ItemsControl ItemsSource="{Binding Children}" Margin="2,0,0,0"
                              Visibility="{Binding ShowBody, Converter={StaticResource BoolVis}}" />
                <ItemsControl ItemsSource="{Binding ReplyChildren}"
                              Visibility="{Binding ShowReplies, Converter={StaticResource BoolVis}}" />
                <StackPanel Orientation="Horizontal" Margin="4,8"
                            Visibility="{Binding ShowRunning, Converter={StaticResource BoolVis}}">
                    <Grid Width="28" Height="28" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TranslateTransform x:Name="WhaleSwim" />
                        </Grid.RenderTransform>
                        <!-- 运行中图标：Assets/think.png（用 png 而非 ico：WPF 解码 ico 会选最小帧再放大导致模糊） -->
                        <Image Source="Assets/think.png" Width="28" Height="28"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <Grid.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="WhaleSwim" Storyboard.TargetProperty="Y"
                                                         From="0" To="-3" Duration="0:0:0.8" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Grid.Triggers>
                    </Grid>
                    <TextBlock Text="正在工作…" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9" AutoReverse="True" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ===== sidebar templates ===== -->
        <DataTemplate DataType="{x:Type local:SessionRowVm}">
            <Border x:Name="RowBd" CornerRadius="8" Padding="8" Background="Transparent"
                    MouseLeftButtonUp="SessionRow_Click" Cursor="Hand">
                <DockPanel>
                    <Ellipse Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource TextTertiary}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Running}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource Accent}" />
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="RowPulse">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.35" Duration="0:0:0.6" AutoReverse="True" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="RowPulse" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel x:Name="RowActions" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="RenameRow_Click" ToolTip="重命名">
                            <Path Data="{StaticResource PencilGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="ArchiveRow_Click" ToolTip="归档">
                            <Path Data="{StaticResource ArchiveGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="DeleteRow_Click" ToolTip="删除"
                                AutomationProperties.Name="删除会话">
                            <Path Data="{StaticResource TrashGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextTertiary}" Margin="0,1,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource BgLayer2}" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource BgLayer2}" />
                    <Setter TargetName="RowActions" Property="Visibility" Value="Visible" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- file tree template -->
        <HierarchicalDataTemplate DataType="{x:Type local:FileEntryVm}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <Path x:Name="EntryIcon" Data="{StaticResource FileGeo}" Stroke="{DynamicResource TextTertiary}"
                      StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" />
                <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                    <Setter TargetName="EntryIcon" Property="Data" Value="{StaticResource FolderGeo}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <Style x:Key="FileTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template" Value="{DynamicResource TreeItemTemplate}" />
        </Style>

        <!-- shared tree item chrome: no system selection blue, header stretches so titles trim -->
        <ControlTemplate x:Key="TreeItemTemplate" TargetType="TreeViewItem">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ToggleButton x:Name="Expander" Grid.Row="0" Grid.Column="0" Width="16" Height="16"
                              Margin="0,0,2,0" ClickMode="Press" Focusable="False" Cursor="Hand"
                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                              Visibility="{Binding HasItems, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border Background="Transparent" Width="16" Height="16">
                                <Path Data="{StaticResource ChevronGeo}" Stroke="{DynamicResource TextTertiary}"
                                      StrokeThickness="1.6" Width="10" Height="10" Stretch="Uniform"
                                      RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=TreeViewItem}, Converter={StaticResource BoolAngle}, ConverterParameter=90}" />
                                    </Path.RenderTransform>
                                </Path>
                            </Border>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Border x:Name="Bd" Grid.Row="0" Grid.Column="1" Background="Transparent" CornerRadius="8"
                        Padding="{TemplateBinding Padding}" HorizontalAlignment="Stretch">
                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                </Border>
                <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Margin="16,0,0,0"
                                Visibility="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolVis}}" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgLayer2}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Bd" Property="Background" Value="Transparent" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- workspace tree -->
        <Style x:Key="WorkspaceTreeItem" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template" Value="{StaticResource TreeItemTemplate}" />
        </Style>

        <Style x:Key="SessionTreeItem" TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template" Value="{StaticResource TreeItemTemplate}" />
        </Style>

        <!-- 注意：HierarchicalDataTemplate.ItemContainerStyle 作用于“子项”容器（SessionRowVm），
             顶层组容器由 TreeView.ItemContainerStyle 提供。IsExpanded 绑定只存在于
             WorkspaceTreeItem（组有该属性）；给子项用它会报 BindingExpression path error。 -->
        <HierarchicalDataTemplate DataType="{x:Type local:WorkspaceGroupVm}" ItemsSource="{Binding Children}"
                                  ItemContainerStyle="{StaticResource SessionTreeItem}">
            <DockPanel Margin="0,2" MinHeight="26" Loaded="GroupRow_Loaded">
                <StackPanel x:Name="GroupActions" DockPanel.Dock="Right" Orientation="Horizontal"
                            Opacity="0" IsHitTestVisible="False">
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                            Click="NewSessionInWorkspace_Click" ToolTip="在此工作区新建会话">
                        <Path Data="{StaticResource PlusGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6" Width="12" Height="12" Stretch="Uniform" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="24" Height="24"
                            Click="DeleteWorkspace_Click" ToolTip="删除工作区" AutomationProperties.Name="删除工作区">
                        <Path Data="{StaticResource TrashGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="13" Height="13" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <Path Data="{StaticResource FolderGeo}" Stroke="{DynamicResource TextSecondary}"
                      StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                      VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>
            <HierarchicalDataTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="GroupActions" Property="Opacity" Value="1" />
                    <Setter TargetName="GroupActions" Property="IsHitTestVisible" Value="True" />
                </Trigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- windows caption -->
        <!-- composer stats icons (gauge / database, mirrors IconGauge/IconDatabase outline) -->
        <StreamGeometry x:Key="GaugeGeo">M2.5,11 a6,6 0 1 1 11,0 M8,11 L10.6,7.2</StreamGeometry>
        <StreamGeometry x:Key="DatabaseGeo">M3,4 a5,2.2 0 0 0 10,0 a5,2.2 0 0 0 -10,0 M3,4 v8 a5,2.2 0 0 0 10,0 v-8 M3,8 a5,2.2 0 0 0 10,0</StreamGeometry>

        <!-- composer stat pill: tertiary reading, hover lifts to secondary on the hover fill -->
        <Style x:Key="StatPill" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiary}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="8,1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgLayer2}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <StreamGeometry x:Key="CapMinGeo">M0,5.5 H10</StreamGeometry>
        <StreamGeometry x:Key="CapMaxGeo">M0.5,0.5 h9 v9 h-9 z</StreamGeometry>
        <StreamGeometry x:Key="CapRestoreGeo">M2.5,0.5 h7 v7 h-7 z M0.5,2.5 v7 h7</StreamGeometry>
        <StreamGeometry x:Key="CapCloseGeo">M0,0 L10,10 M10,0 L0,10</StreamGeometry>

        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderL1}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BorderL2}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#C42B1C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#B3271A" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource SidebarFill}">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- caption row: drag area + windows-style controls -->
        <DockPanel Grid.Row="0" Background="{DynamicResource SidebarFill}">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource CaptionButton}" Click="CaptionMinimize_Click" ToolTip="最小化">
                    <Path Data="{StaticResource CapMinGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" />
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="CaptionMaximize_Click" ToolTip="最大化/还原">
                    <Grid Width="10" Height="10">
                        <Path Data="{StaticResource CapMaxGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <Path Data="{StaticResource CapRestoreGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Stretch="Uniform">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>
                <Button Style="{StaticResource CaptionCloseButton}" Click="CaptionClose_Click" ToolTip="关闭">
                    <Path Data="{StaticResource CapCloseGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform" />
                </Button>
            </StackPanel>
            <Grid />
        </DockPanel>

        <Grid x:Name="FrameGrid" Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="280" />
            <ColumnDefinition Width="*" MinWidth="400" />
            <ColumnDefinition x:Name="RightColumn" Width="0" />
        </Grid.ColumnDefinitions>

        <!-- ===== sidebar ===== -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarFill}"
                BorderBrush="{DynamicResource BorderL1}" BorderThickness="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,14,12,10"
                           Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <Button x:Name="CollapseSidebarBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="CollapseSidebar_Click" ToolTip="折叠侧栏">
                        <Path Data="{StaticResource SidebarGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- 左上角 Logo：Assets/logo.png（与窗口/任务栏图标同源） -->
                        <Image Source="Assets/logo.png" Width="30" Height="30" Margin="0,0,8,0"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="MyAgent" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,14,0,10"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}}">
                    <Image Source="Assets/logo.png" Width="30" Height="30" HorizontalAlignment="Center" Margin="0,0,0,10"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <Button Style="{StaticResource IconButton}" HorizontalAlignment="Center"
                            Click="CollapseSidebar_Click" ToolTip="展开侧栏">
                        <Path Data="{StaticResource SidebarGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
                <Button x:Name="NewSessionBtn" DockPanel.Dock="Top" Click="NewSession_Click" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <!-- 内联 Style 会屏蔽隐式 Button 样式，需自带主题前景色（深色模式下为浅色文字）。 -->
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Setter Property="Margin" Value="12,0,12,10" />
                            <Setter Property="Padding" Value="12,8" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                    <Setter Property="Margin" Value="8,0,8,10" />
                                    <Setter Property="Padding" Value="8" />
                                    <Setter Property="HorizontalContentAlignment" Value="Center" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{DynamicResource BgLayer1}" CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderL2}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource PlusGeo}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                        <TextBlock Text="新建会话" FontSize="13" FontWeight="Medium"
                                   Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                    </StackPanel>
                </Button>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource BorderL1}" BorderThickness="0,1,0,0" Padding="12,10">
                    <Button Click="Settings_Click">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource RowButton}">
                                <Setter Property="Padding" Value="10,8" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}" Value="True">
                                        <Setter Property="Padding" Value="8" />
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" Margin="0,0,8,0">
                                <Path Data="{StaticResource GearGeo}" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" Stretch="Uniform" />
                                <Ellipse Width="4.4" Height="4.4" Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="设置" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                       Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </Button>
                </Border>
                <DockPanel Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                    <StackPanel DockPanel.Dock="Top" Margin="12,4,12,6">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Click="AddWorkspace_Click" ToolTip="添加工作区">
                                <Path Data="{StaticResource FolderPlusGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="16" Height="16" Stretch="Uniform" />
                            </Button>
                            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                    Click="SearchToggle_Click" ToolTip="搜索会话" AutomationProperties.Name="搜索会话">
                                <Path Data="{StaticResource SearchGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4" Width="15" Height="15" Stretch="Uniform" />
                            </Button>
                            <TextBlock Text="工作区" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </DockPanel>
                        <TextBox Margin="0,6,0,0" FontSize="12.5" Padding="8,6"
                                 Visibility="{Binding IsSearchOpen, Converter={StaticResource BoolVis}}"
                                 Text="{Binding SessionFilter, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8,0,8,8">
                        <TreeView ItemsSource="{Binding Sessions}" Background="Transparent" BorderThickness="0"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  ItemContainerStyle="{StaticResource WorkspaceTreeItem}"
                                  VirtualizingPanel.IsVirtualizing="False" />
                    </ScrollViewer>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- ===== center ===== -->
        <Border Grid.Column="1" x:Name="CenterBorder" CornerRadius="16,0,0,0" ClipToBounds="True"
                Background="{DynamicResource BgBase}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EmptyTopRow" Height="0" />
                <RowDefinition x:Name="ChatRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EmptyBottomRow" Height="0" />
            </Grid.RowDefinitions>
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderL1}" BorderThickness="0,0,0,1" Padding="20,12">
                <DockPanel>
                    <Button x:Name="RightbarToggleBtn" DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                            Click="RightbarToggle_Click" ToolTip="文件面板">
                        <Path Data="{StaticResource RightbarGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentChat.Cwd}" FontSize="12"
                               Foreground="{DynamicResource TextTertiary}" TextTrimming="CharacterEllipsis"
                               MaxWidth="300" Margin="10,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding CurrentChat.Title, FallbackValue=New Session}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Grid.Row="3" Padding="24,8,24,16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentChat.IsEmpty}" Value="True">
                                <Setter Property="Padding" Value="24,8,24,40" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel MaxWidth="748">
                    <!-- workspace chip + picker (empty state) -->
                    <Button x:Name="WorkspaceChip" HorizontalAlignment="Left" Margin="0,0,0,8" Padding="8,5"
                            Cursor="Hand" Click="WorkspacePickerChip_Click"
                            AutomationProperties.Name="选择工作区"
                            Visibility="{Binding CurrentChat.IsEmpty, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{DynamicResource BgLayer1}" BorderBrush="{DynamicResource BorderL2}"
                                        BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource FolderGeo}" Stroke="{DynamicResource TextSecondary}"
                                  StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding SelectedWorkspace.Name, FallbackValue=选择工作区}" FontSize="12"
                                       Foreground="{DynamicResource TextSecondary}" Margin="6,0,0,0" VerticalAlignment="Center" />
                            <Path Data="{StaticResource ChevronDownGeo}" Stroke="{DynamicResource TextTertiary}"
                                  StrokeThickness="1.5" Width="10" Height="10" Stretch="Uniform" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Popup x:Name="WorkspacePicker" PlacementTarget="{Binding ElementName=WorkspaceChip}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" VerticalOffset="4">
                        <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource BorderL2}"
                                BorderThickness="1" CornerRadius="12" Padding="4" MinWidth="280">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding PickerItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource RowButton}" Padding="8,6" Click="WorkspacePick_Click"
                                                    AutomationProperties.Name="{Binding Display}">
                                                <DockPanel>
                                                    <Path DockPanel.Dock="Right" Data="{StaticResource CheckGeo}"
                                                          Stroke="{DynamicResource Accent}" StrokeThickness="1.6"
                                                          Width="12" Height="12" Stretch="Uniform" Margin="6,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding IsCurrent, Converter={StaticResource BoolVis}}" />
                                                    <Path DockPanel.Dock="Left" Data="{StaticResource FolderGeo}"
                                                          Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4"
                                                          Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0"
                                                          VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Display}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="1" Background="{DynamicResource BorderL1}" Margin="4,4" />
                                <Button Style="{StaticResource RowButton}" Padding="8,6" Click="AddWorkspace_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource FolderPlusGeo}" Stroke="{DynamicResource TextSecondary}"
                                              StrokeThickness="1.4" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" />
                                        <TextBlock Text="添加工作区…" FontSize="13" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <!-- todo summary：默认折叠为一行摘要（进度 + 当前任务），点击展开；
                         展开列表限高内滚，长清单不再挤压对话区。 -->
                    <Border Visibility="{Binding CurrentChat.HasTodos, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                            BorderBrush="{DynamicResource BorderL1}" BorderThickness="1" CornerRadius="12"
                            Background="{DynamicResource BgLayer1}" Padding="14,8" Margin="0,0,0,8">
                        <StackPanel>
                            <Button Style="{StaticResource RowButton}" Padding="0" Click="TodoSummary_Click"
                                    ToolTip="点击展开 / 收起任务清单" HorizontalContentAlignment="Stretch">
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="{StaticResource ChevronDownGeo}"
                                          Stroke="{DynamicResource TextTertiary}" StrokeThickness="1.5"
                                          Width="10" Height="10" Stretch="Uniform" Margin="8,0,0,0"
                                          VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <RotateTransform Angle="{Binding CurrentChat.IsTodoExpanded,
                                                Converter={StaticResource BoolAngle}, ConverterParameter=180}" />
                                        </Path.RenderTransform>
                                    </Path>
                                    <TextBlock DockPanel.Dock="Left" Text="任务清单" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" />
                                    <Border DockPanel.Dock="Left" Background="{DynamicResource AccentSoft}" CornerRadius="5"
                                            Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CurrentChat.TodoProgress, FallbackValue=0/0}"
                                                   FontSize="10.5" Foreground="{DynamicResource Accent}" />
                                    </Border>
                                    <TextBlock Text="{Binding CurrentChat.CurrentTodoText}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondary}" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                               Visibility="{Binding CurrentChat.HasCurrentTodo, Converter={StaticResource BoolVis}}" />
                                </DockPanel>
                            </Button>
                            <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0"
                                          Visibility="{Binding CurrentChat.IsTodoExpanded, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}">
                                <ItemsControl ItemsSource="{Binding CurrentChat.Todos}"
                                              ItemTemplate="{StaticResource TodoRowTemplate}" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <!-- goal bar (mirrors ui-goal GoalBar: objective + phase + actions) -->
                    <Border Visibility="{Binding Goal.HasGoal, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                            Background="{DynamicResource BgLayer2}" CornerRadius="10" Padding="10,6" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="编辑" Click="GoalEdit_Click" ToolTip="编辑目标" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextSecondary}"
                                        FontSize="11" Padding="6,2" />
                                <Button Click="GoalPauseResume_Click" Cursor="Hand" Background="Transparent" BorderThickness="0"
                                        Foreground="{DynamicResource TextSecondary}" FontSize="11" Padding="6,2">
                                    <Button.Content>
                                        <Binding Path="Goal.Phase" Converter="{StaticResource BoolToText}"
                                                 ConverterParameter="暂停|继续" />
                                    </Button.Content>
                                </Button>
                                <Button Content="清除" Click="GoalClear_Click" ToolTip="清除目标" Cursor="Hand"
                                        Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Danger}"
                                        FontSize="11" Padding="6,2" />
                            </StackPanel>
                            <Border DockPanel.Dock="Left" Background="{DynamicResource AccentSoft}" CornerRadius="5"
                                    Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Goal.Phase}" FontSize="10.5" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <TextBlock Text="{Binding Goal.Objective}" FontSize="12" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"
                                       ToolTip="{Binding Goal.Progress}" />
                        </DockPanel>
                    </Border>

                    <!-- plan chip (mirrors ui-plan PlanChip: renders the effective target
                         `pending ? !active : active`; clicking exits plan mode) -->
                    <Border Visibility="{Binding IsPlanTargetActive, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                            Background="{DynamicResource AccentSoft}" CornerRadius="8" Padding="10,4"
                            HorizontalAlignment="Left" Margin="0,0,0,8">
                        <Button Click="ExitPlanMode_Click" Background="Transparent" BorderThickness="0" Cursor="Hand" Padding="0"
                                ToolTip="退出计划模式">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="计划模式 · 点击退出" FontSize="11.5" Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="（下一步生效）" FontSize="11.5" Foreground="{DynamicResource Accent}" Opacity="0.75"
                                           Visibility="{Binding IsPlanPending, Converter={StaticResource BoolVis}}" />
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- sandbox escalation approval panel (mirrors ui-approval ApprovalPanel) -->
                    <Border Visibility="{Binding HasPendingApproval, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                            Background="{DynamicResource BgLayer1}" BorderBrush="{DynamicResource Danger}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="沙箱权限审批" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Danger}" />
                                <Border Background="{DynamicResource AccentSoft}" CornerRadius="5" Padding="6,1" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding ApprovalToolName}" FontSize="11"
                                               FontFamily="{StaticResource MonoFont}" Foreground="{DynamicResource Accent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding ApprovalReason}" FontSize="12.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="拒绝" Click="RejectEscalation_Click" Cursor="Hand"
                                        Background="Transparent" BorderBrush="{DynamicResource BorderL2}" BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondary}" FontSize="12" Padding="12,5" Margin="0,0,8,0" />
                                <Button Content="仅本次允许" Click="ApproveEscalation_Click" Cursor="Hand"
                                        Background="{DynamicResource Danger}" BorderThickness="0"
                                        Foreground="White" FontSize="12" Padding="12,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- plan review panel (mirrors PlanReviewPanel: approve / discuss) -->
                    <Border Visibility="{Binding HasPendingReview, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                            Background="{DynamicResource BgLayer1}" BorderBrush="{DynamicResource Warning}"
                            BorderThickness="1" CornerRadius="12" Padding="14,10" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="计划审批" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Warning}" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding ReviewQuestion}" FontSize="12.5"
                                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ReviewPlanText}" FontSize="11.5" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextSecondary}" MaxHeight="120" Margin="0,6,0,10" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="继续讨论" Click="DiscussPlan_Click" Cursor="Hand"
                                        Background="Transparent" BorderBrush="{DynamicResource BorderL2}" BorderThickness="1"
                                        Foreground="{DynamicResource TextSecondary}" FontSize="12" Padding="12,5" Margin="0,0,8,0" />
                                <Button Content="批准计划" Click="ApprovePlan_Click" Cursor="Hand"
                                        Background="{DynamicResource Accent}" BorderThickness="0"
                                        Foreground="White" FontSize="12" Padding="12,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- compaction progress: a checkpoint summarization call is in flight -->
                    <Border Visibility="{Binding CurrentChat.IsCompacting, Converter={StaticResource BoolVis}, FallbackValue=Collapsed}"
                            Background="{DynamicResource BgLayer2}" CornerRadius="12" Padding="14,8" Margin="0,0,0,8">
                        <TextBlock Text="正在压缩上下文为检查点摘要…（对话仍在进行，请稍候）" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondary}" />
                    </Border>

                    <!-- input card -->
                    <Border x:Name="InputCard" BorderBrush="{DynamicResource BorderL2}" BorderThickness="1"
                            CornerRadius="20" Background="{DynamicResource BgLayer1}" Padding="12,10,12,8">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.05" Color="#0F1115" />
                        </Border.Effect>
                        <StackPanel>
                            <Grid>
                                <!-- MinHeight：默认约两行的输入空间，随内容继续长高至 MaxHeight 后内滚 -->
                                <TextBox x:Name="InputBox" AcceptsReturn="True" TextWrapping="Wrap"
                                         MinHeight="80" MaxHeight="200"
                                         Background="Transparent" BorderThickness="0" FontSize="14"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" Padding="0,0,0,4"
                                         PreviewKeyDown="InputBox_PreviewKeyDown" />
                                <TextBlock Text="给 MyAgent 发送消息…" Foreground="{DynamicResource TextTertiary}"
                                           IsHitTestVisible="False" FontSize="14" Padding="2,0,0,4">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=InputBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                            <DockPanel Margin="0,6,0,0">
                                <Button x:Name="SendBtn" DockPanel.Dock="Right" Width="32" Height="32" Click="Send_Click" Cursor="Hand">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="8" Background="{DynamicResource BrandPrimary}">
                                                <Grid>
                                                    <Path x:Name="SendIcon" Data="{StaticResource SendGeo}"
                                                          Stroke="{DynamicResource BrandPrimaryText}" StrokeThickness="1.8"
                                                          Width="16" Height="16" Stretch="Uniform"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Rectangle x:Name="StopIcon" Width="10" Height="10" RadiusX="1.5" RadiusY="1.5"
                                                               Fill="White" Visibility="Collapsed"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding CurrentChat.IsRunning}" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Danger}" />
                                                    <Setter TargetName="SendIcon" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="StopIcon" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="Bd" Property="Opacity" Value="0.4" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <!-- permission preset selector (mirrors ui-permission-presets PermissionSelect) -->
                                <ComboBox x:Name="PermissionSelect" DockPanel.Dock="Left"
                                          ItemsSource="{Binding PermissionOptions}" SelectedValuePath="Value"
                                          SelectedValue="{Binding SelectedPermission}" DisplayMemberPath="Name"
                                          FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                          Background="Transparent" BorderThickness="0" MaxWidth="170"
                                          VerticalAlignment="Center" HorizontalAlignment="Left"
                                          ToolTip="权限预设：沙箱模式 + 审批策略（作用于当前会话）" />
                                <ComboBox x:Name="ModelSelect" ItemsSource="{Binding Models}" SelectedValuePath="Id"
                                          SelectedValue="{Binding SelectedModel}" DisplayMemberPath="Name"
                                          FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                          Background="Transparent" BorderThickness="0" MaxWidth="180"
                                          VerticalAlignment="Center" HorizontalAlignment="Left" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <!-- composer statistics dock (mirrors harness StatsPills + ContextMeter) -->
                    <DockPanel Margin="6,6,6,0" DataContext="{Binding ComposerStats}">
                        <!-- context-occupancy ring meter, docked right -->
                        <Grid DockPanel.Dock="Right" Visibility="{Binding HasContext, Converter={StaticResource BoolVis}}">
                            <Button x:Name="ContextMeterBtn" Style="{StaticResource StatPill}"
                                    Click="ContextMeter_Click" ToolTip="{Binding ContextTooltip}"
                                    AutomationProperties.Name="{Binding ContextTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <Grid Width="14" Height="14" Margin="0,0,6,0">
                                        <Ellipse Width="13" Height="13" Stroke="{DynamicResource BorderL2}" StrokeThickness="2" />
                                        <Ellipse Width="13" Height="13" Stroke="{DynamicResource TextTertiary}" StrokeThickness="2"
                                                 StrokeDashArray="{Binding RingDashArray}" StrokeDashCap="Round"
                                                 RenderTransformOrigin="0.5,0.5">
                                            <Ellipse.RenderTransform>
                                                <RotateTransform Angle="-90" />
                                            </Ellipse.RenderTransform>
                                        </Ellipse>
                                    </Grid>
                                    <TextBlock Text="{Binding ContextPercentText}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Popup IsOpen="{Binding IsContextOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=ContextMeterBtn}" Placement="Top" VerticalOffset="-8"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource BorderL1}"
                                        BorderThickness="1" CornerRadius="12" Padding="12" Width="264" Margin="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#0F1115" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ContextFigures}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="上下文已用" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                                <TextBlock Text="{Binding ContextPercentText}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </DockPanel>
                                        <!-- occupancy bar: total length = provider-exact percent; breakdown proportions the parts -->
                                        <Border Height="4" CornerRadius="2" Background="{DynamicResource BgLayer2}" Margin="0,10,0,12"
                                                ClipToBounds="True">
                                            <StackPanel Orientation="Horizontal">
                                                <Rectangle Height="4" Width="{Binding SystemBarWidth}" Fill="#ADB2B8" RadiusX="1" RadiusY="1" Margin="0,0,1,0" />
                                                <Rectangle Height="4" Width="{Binding ToolsBarWidth}" Fill="#A78BFA" RadiusX="1" RadiusY="1" Margin="0,0,1,0" />
                                                <Rectangle Height="4" Width="{Binding MessagesBarWidth}" Fill="#4D93F8" RadiusX="1" RadiusY="1" />
                                                <Rectangle Height="4" Width="{Binding PlainBarWidth}" Fill="{DynamicResource TextTertiary}" RadiusX="1" RadiusY="1" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Visibility="{Binding HasBreakdown, Converter={StaticResource BoolVis}}">
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding SystemTokensText}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="#ADB2B8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="系统提示词" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ToolsTokensText}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="#A78BFA" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="工具定义" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <DockPanel Margin="0,2">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding MessagesTokensText}" FontSize="12" Foreground="{DynamicResource TextPrimary}" />
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="2" Background="#4D93F8" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="对话消息" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- activity pill: counts · decode speed -->
                        <Grid HorizontalAlignment="Left" Visibility="{Binding HasActivity, Converter={StaticResource BoolVis}}">
                            <Button x:Name="ActivityPillBtn" Style="{StaticResource StatPill}" Click="ActivityPill_Click"
                                    ToolTip="{Binding ActivityLabel}" AutomationProperties.Name="{Binding ActivityLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource GaugeGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ActivityLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Popup IsOpen="{Binding IsActivityOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=ActivityPillBtn}" Placement="Top" VerticalOffset="-8"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource BorderL1}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" MinWidth="300" Margin="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#0F1115" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ActivityCounts}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource GaugeGeo}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.3"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="会话统计" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderL2}" Margin="0,0,0,10" />
                                        <DockPanel Margin="0,3" Visibility="{Binding HasLlmTime, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding LlmTimeText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="模型用时" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3" Visibility="{Binding HasToolTime, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding ToolTimeText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="工具调用用时" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3" Visibility="{Binding HasTtft, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding TtftText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="首 token 平均（TTFT）" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3" Visibility="{Binding HasSpeed, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding SpeedText}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="输出速度（TPS）" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>

                        <!-- usage pill: whole-log token total · cache hit -->
                        <Grid HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="{Binding HasUsage, Converter={StaticResource BoolVis}}">
                            <Button x:Name="UsagePillBtn" Style="{StaticResource StatPill}" Click="UsagePill_Click"
                                    ToolTip="{Binding UsageLabel}" AutomationProperties.Name="{Binding UsageLabel}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DatabaseGeo}" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.3" Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding UsageLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Popup IsOpen="{Binding IsUsageOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                                   PlacementTarget="{Binding ElementName=UsagePillBtn}" Placement="Top" VerticalOffset="-8"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource MenuSurface}" BorderBrush="{DynamicResource BorderL1}"
                                        BorderThickness="1" CornerRadius="12" Padding="16" MinWidth="300" Margin="12">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.18" Color="#0F1115" />
                                    </Border.Effect>
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding UsageTotalExact}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimary}" />
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="{StaticResource DatabaseGeo}" Stroke="{DynamicResource TextPrimary}" StrokeThickness="1.3"
                                                      Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                <TextBlock Text="Token 用量" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderL2}" Margin="0,0,0,10" />
                                        <DockPanel Margin="0,3" Visibility="{Binding HasCacheHit, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CacheHitValue}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="缓存命中" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding InputExact}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="未缓存输入" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CacheReadExact}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="缓存读取" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3" Visibility="{Binding HasCacheWrite, Converter={StaticResource BoolVis}}">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding CacheWriteExact}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="缓存写入" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <DockPanel Margin="0,3">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding OutputExact}" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                            <TextBlock Text="输出" FontSize="12" Foreground="{DynamicResource TextTertiary}" />
                                        </DockPanel>
                                        <Border Height="1" Background="{DynamicResource BorderL2}" Margin="0,10,0,8" />
                                        <TextBlock Text="{Binding ProviderMeta}" FontSize="11" Foreground="{DynamicResource TextTertiary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2">
                <!-- 虚拟化聊天列表：只实例化视口附近的 turn（大会话首屏从 4 万+可视元素降到
                     一屏的量）。ScrollUnit=Pixel 保持像素级偏移——贴底跟随/滚轮逻辑与
                     SlimScrollBar 的 Value/Maximum 绑定全部按像素工作，语义不变。
                     内层 ScrollViewer 命名 ChatScroll，由代码后置从模板解析，
                     原有 ScrollChanged/PreviewMouseWheel/ScrollToEnd 逻辑原样复用。 -->
                <ItemsControl x:Name="ChatList" ItemsSource="{Binding CurrentChat.Items}"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Standard"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer x:Name="ChatScroll" Focusable="False"
                                          CanContentScroll="True"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <!-- Stretch + MaxWidth：占满视口、上限 700、超宽时居中。
                                     不能用 Center——那样列宽由内容撑开，首条短消息时整列
                                     缩成气泡宽度悬在屏幕中间，LLM 回复撑宽后气泡才跳到右边。 -->
                                <ItemsPresenter MaxWidth="700" Margin="24,20,24,12" HorizontalAlignment="Stretch" />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                </ItemsControl>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,28"
                            Visibility="{Binding CurrentChat.IsEmpty, Converter={StaticResource BoolVis}, FallbackValue=Visible}">
                    <!-- 空态欢迎页 Logo：与左上角/任务栏同源（Assets/logo.png） -->
                    <Image Source="Assets/logo.png" Width="72" Height="72" HorizontalAlignment="Center" Margin="0,0,0,14"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="MyAgent" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,6" />
                    <TextBlock Text="属于你自己的本地编码智能体" FontSize="13" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
        </Border>

        <!-- ===== right bar: files + five capability panels ===== -->
        <Border Grid.Column="2" Background="{DynamicResource SidebarFill}"
                BorderBrush="{DynamicResource BorderL1}" BorderThickness="1,0,0,0">
            <TabControl Background="Transparent" BorderThickness="0"
                        ItemContainerStyle="{StaticResource TopTabItem}">
                <!-- files -->
                <TabItem Header="文件">
                    <TreeView ItemsSource="{Binding FileTree}" ItemContainerStyle="{StaticResource FileTreeItem}"
                              Background="Transparent" BorderThickness="0" Padding="8"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="False" />
                </TabItem>
                <!-- goal -->
                <TabItem Header="目标">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <Border Background="{DynamicResource BgLayer2}" CornerRadius="10" Padding="14" Visibility="{Binding Goal.HasGoal, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <TextBlock Text="当前目标" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding Goal.Objective}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource TextPrimary}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Border Background="{DynamicResource AccentSoft}" CornerRadius="6" Padding="8,3">
                                            <TextBlock Text="{Binding Goal.Phase}" FontSize="11" Foreground="{DynamicResource Accent}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Goal.Progress}" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,8,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="尚无目标。让 Agent 创建目标，或输入长期任务。" FontSize="12.5" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" Visibility="{Binding Goal.HasGoal, Converter={StaticResource BoolVis}, ConverterParameter=invert}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- plan -->
                <TabItem Header="计划">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                        <StackPanel>
                            <TextBlock Text="计划协作模式" FontSize="13" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10" />
                            <TextBlock Text="进入后 Agent 先探索与规划，提交方案经你确认后再执行。" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,14" />
                            <Border Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="8,5" HorizontalAlignment="Left" Margin="0,0,0,10">
                                <TextBlock Text="{Binding PlanStatusText}" FontSize="12" Foreground="{DynamicResource Accent}" />
                            </Border>
                            <Button Content="切换计划模式" Click="TogglePlanMode_Click" HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentSoft}" Foreground="{DynamicResource Accent}"
                                    BorderThickness="0" Padding="12,6" Cursor="Hand" FontSize="12" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <!-- team -->
                <TabItem Header="团队">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource BorderL1}" BorderThickness="0,0,0,1" Padding="10,8">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Click="ToggleTeamMode_Click" Cursor="Hand" FontSize="11"
                                        Background="{DynamicResource BgLayer2}" BorderThickness="0"
                                        Foreground="{DynamicResource Accent}" Padding="8,3">
                                    <Button.Content>
                                        <Binding Path="IsTeamEnabled" Converter="{StaticResource BoolToText}"
                                                 ConverterParameter="关闭团队|开启团队" />
                                    </Button.Content>
                                </Button>
                                <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center">
                                    <TextBlock.Text>
                                        <Binding Path="IsTeamEnabled" Converter="{StaticResource BoolToText}"
                                                 ConverterParameter="团队模式：开启|团队模式：关闭" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <TextBlock Text="尚无共享任务。使用 team_task_create 创建任务板。" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                       TextWrapping="Wrap" Margin="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TeamTasks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding TeamTasks}" Margin="8">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                            <StackPanel>
                                                <DockPanel>
                                                    <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right" />
                                                    <TextBlock Text="{Binding Subject}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Text="{Binding Owner, StringFormat=负责人: {0}}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </TabItem>
                <!-- schedule -->
                <TabItem Header="定时">
                    <Grid>
                        <TextBlock Text="尚无定时任务。使用 schedule_create 创建提醒或周期任务。" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Schedules.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Schedules}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right" />
                                                <TextBlock Text="{Binding Title}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
                                                <Run Text="{Binding Kind}" /> · 下次 <Run Text="{Binding Next}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>
                <!-- workflow -->
                <TabItem Header="流程">
                    <Grid>
                        <TextBlock Text="尚无流程记录。使用 workflow 工具编排多子任务。" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap" Margin="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Workflows.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Workflows}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Margin="0,4,0,0">
                                                <Run Text="{Binding StopReason}" /> · <Run Text="{Binding AgentsStarted}" /> 个子任务
                                            </TextBlock>
                                            <TextBlock Text="{Binding Phases, Converter={StaticResource JoinText}}"
                                                       FontSize="10" Foreground="{DynamicResource TextTertiary}" Margin="0,3,0,0"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>
                <!-- subagents (mirrors list_agents / TeamModeToggle roster) -->
                <TabItem Header="成员">
                    <ItemsControl ItemsSource="{Binding Agents}" Margin="8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                    <DockPanel>
                                        <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                            <TextBlock Text="{Binding Description}" FontSize="10.5" Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </TabItem>
                <!-- background jobs (mirrors ui-jobs JobListAction) -->
                <TabItem Header="后台">
                    <Grid>
                        <TextBlock Text="尚无后台任务。workflow 的 run_in_background 会在此显示。" FontSize="12"
                                   Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="12">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding JobList.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding JobList}" Margin="8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgLayer2}" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                        <DockPanel>
                                            <TextBlock Text="{Binding StatusLabel}" FontSize="10.5" Foreground="{DynamicResource Accent}" DockPanel.Dock="Right" />
                                            <StackPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                                <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}">
                                                    <Run Text="{Binding Id}" /> · <Run Text="{Binding OutputBytes}" /> 字节输出
                                                </TextBlock>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </TabItem>
            </TabControl>
        </Border>

        <!-- ===== toasts ===== -->
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Toasts}"
                      HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource MenuSurface}" CornerRadius="12" Padding="18,10" Margin="0,4"
                              BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderL2}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Danger}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" MaxWidth="560">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        </Grid>
    </Grid>
</Window>
